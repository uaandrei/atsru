rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

		match /invitations/{document=**} {
    	allow create: if request.auth == null; // Allow anonymous users to create documents
      allow read: if request.auth != null; // Only allow authenticated users to read documents
      allow update: if request.auth != null; // Only allow authenticated users to update documents
      allow delete: if request.auth != null; // Only allow authenticated users to delete documents
    }
    
    match /{document=**} {
      allow read, write: if request.auth != null; // rest of collection deny for anonymous users
    }
    
  }
}